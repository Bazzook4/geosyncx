{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run generate && vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/tools/timezone-compare",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/tools/timezone-compare/",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/tools/best-meeting-time",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/tools/best-meeting-time/",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/tools/meeting-scheduler",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/tools/meeting-scheduler/",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/tools/timezone-finder",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/tools/timezone-finder/",
      "destination": "/command-center",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/command-center",
      "permanent": true
    }
  ]
}
